# Copy this file to config.env, fill in the required public identifiers, then
# render and review the public manifests before bootstrap:
#
#   make config
#   $EDITOR platform_setup_scripts/config.env
#   make render-config
#   git diff -- kubernetes/
#
# config.env is deliberately ignored. It is local operator input, not GitOps
# state. Secret *values* are prompted for or streamed only by 02-secrets.sh;
# never put them in this file.

# ---------- required public identifiers ----------

# Target GCP project ID and GitHub repository in owner/repository form.
PROJECT_ID=""
GITHUB_REPO=""

# ---------- topology ----------

# PROJECT_NUMBER is optional. Preflight discovers and verifies it when empty.
PROJECT_NUMBER=""
REGION="us-central1"
ZONE="us-central1-a"
CLUSTER_NAME="resilience-gate"
GAR_REPO="resilience-gate"

# Copy the signed `sha256:...` digest from the gate-runner CI identity artifact.
# Leaving this empty renders an intentionally unresolvable digest, so a fresh
# infrastructure bootstrap is not circular and any attempted gate Job fails
# closed. Render, review, and commit a real digest before requesting staging
# promotion.
GATE_RUNNER_DIGEST=""

# Copy the signed `sha256:...` digest from the signer CI identity artifact.
# Leaving this empty renders an intentionally unresolvable digest. Render,
# review, and commit a real digest before bootstrap reconciles the signer
# workload.
SIGNER_DIGEST=""

# Leave empty to derive "${PROJECT_ID}-tf-state". Set an explicit bucket only
# when a reviewed naming policy requires one.
TF_STATE_BUCKET=""

# ---------- secrets ----------

# SOURCE_PROJECT / SOURCE_ACCOUNT are command-line bootstrap options, never
# persistent configuration. These are names only; values never belong in Git.
SECRETS=(
  resilience-gate-github-pat
  resilience-gate-grafana-admin-password
  resilience-gate-shared-url-shortener-database-url
  resilience-gate-shared-url-shortener-database-password
  resilience-gate-shared-url-shortener-redis-url
  resilience-gate-shared-url-shortener-redis-password
  resilience-gate-shared-service-wallet-address-testnet
  resilience-gate-dev-url-shortener-database-url
  resilience-gate-dev-url-shortener-database-password
  resilience-gate-dev-url-shortener-redis-url
  resilience-gate-dev-url-shortener-redis-password
  resilience-gate-dev-service-wallet-address-testnet
  resilience-gate-staging-url-shortener-database-url
  resilience-gate-staging-url-shortener-database-password
  resilience-gate-staging-url-shortener-redis-url
  resilience-gate-staging-url-shortener-redis-password
  resilience-gate-staging-service-wallet-address-testnet
  resilience-gate-staging-signer-rpc-url-testnet
  resilience-gate-staging-loadgen-wallet-key-1-testnet
  resilience-gate-staging-loadgen-wallet-key-2-testnet
  resilience-gate-staging-loadgen-wallet-key-3-testnet
  resilience-gate-prod-url-shortener-database-url
  resilience-gate-prod-url-shortener-database-password
  resilience-gate-prod-url-shortener-redis-url
  resilience-gate-prod-url-shortener-redis-password
  resilience-gate-prod-service-wallet-address-testnet
)
