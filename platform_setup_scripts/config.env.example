# Copy this file to config.env, fill in the required public identifiers, then
# render and review the public manifests before bootstrap:
#
#   make config
#   $EDITOR platform_setup_scripts/config.env
#   make render-config
#   git diff -- kubernetes/
#
# config.env is deliberately ignored. It is local operator input, not GitOps
# state. Secret *values* are prompted for or streamed only by 02-secrets.sh;
# never put them in this file.

# ---------- required public identifiers ----------

# Target GCP project ID and GitHub repository in owner/repository form.
PROJECT_ID=""
GITHUB_REPO=""

# ---------- topology ----------

# PROJECT_NUMBER is optional. Preflight discovers and verifies it when empty.
PROJECT_NUMBER=""
REGION="us-central1"
ZONE="us-central1-a"
CLUSTER_NAME="resilience-gate"
GAR_REPO="resilience-gate"

# Leave empty to derive "${PROJECT_ID}-tf-state". Set an explicit bucket only
# when a reviewed naming policy requires one.
TF_STATE_BUCKET=""

# ---------- secrets ----------

# SOURCE_PROJECT / SOURCE_ACCOUNT are command-line bootstrap options, never
# persistent configuration. These are names only; values never belong in Git.
SECRETS=(
  database-password
  github-pat
  grafana-admin-password
  radius-rpc-url-testnet
  radius-rpc-url-mainnet
  service-wallet-address-testnet
  service-wallet-address-mainnet
  load-test-wallet-key-1
  load-test-wallet-key-2
  load-test-wallet-key-3
)
