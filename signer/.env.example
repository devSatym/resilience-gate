# Copy to signer/.env and fill with testnet-only credentials. Never commit the
# copied file or fund a listed key outside the owned Radius testnet environment.

# Radius testnet RPC endpoint. The signer contacts it only during boot-time
# Permit2 approval checks, never while serving /sign-permit2.
RPC_URL=https://rpc.testnet.radiustech.xyz
CHAIN_ID=72344
NETWORK_CAIP2=eip155:72344

# The merchant/service wallet receives settled SBC payments. All values below
# are required by docker-compose.payments.yml except optional wallet slots 2/3.
SERVICE_WALLET_ADDRESS=
SBC_CONTRACT_ADDRESS=0x33ad9e4bd16b69b5bfded37d8b5d9ff9aba014fb
PERMIT2_CONTRACT_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
X402_PROXY_ADDRESS=0x402085c248EeA27D92E8b30b2C58ed07f9E20001
FACILITATOR_URL=https://facilitator.testnet.radiustech.xyz

# Payer private keys remain only in this ignored file or in a secret manager.
WALLET_KEY_1=
WALLET_KEY_2=
WALLET_KEY_3=

# Atomic SBC amount and bounded signer/RPC timeouts.
SBC_AMOUNT=1000
DEADLINE_SECONDS=300
MAX_DEADLINE_SECONDS=300
RPC_TIMEOUT_SECONDS=10
APPROVAL_TX_TIMEOUT_SECONDS=60
