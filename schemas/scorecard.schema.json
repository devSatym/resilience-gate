{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience-gate.example.invalid/schemas/scorecard/v1",
  "title": "Resilience Gate chaos scorecard",
  "description": "A fail-closed verdict for one bounded chaos experiment and one immutable release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment",
    "verdict",
    "generated_at",
    "release",
    "window",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "resilience-gate.scorecard/v1"
    },
    "experiment": {
      "type": "string",
      "enum": [
        "postgres-pod-failure",
        "redis-pod-failure",
        "signer-pod-failure"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "image_digest", "run_id"],
      "properties": {
        "revision": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "image_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "run_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "window": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inject_at",
            "start",
            "end",
            "duration_seconds",
            "settle_seconds"
          ],
          "properties": {
            "inject_at": {"type": "string", "format": "date-time"},
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"},
            "duration_seconds": {"type": "integer", "minimum": 1},
            "settle_seconds": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "verdict",
          "observed",
          "operator",
          "threshold",
          "unit",
          "expression",
          "query_kind",
          "sample_count",
          "reason",
          "evidence_error"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "verdict": {"type": "string", "enum": ["pass", "fail"]},
          "observed": {"type": ["number", "null"]},
          "operator": {"type": "string", "enum": ["<", "<=", ">", ">=", "=="]},
          "threshold": {"type": "number"},
          "unit": {"type": "string"},
          "expression": {"type": "string", "minLength": 1},
          "query_kind": {"type": "string", "enum": ["instant", "range"]},
          "sample_count": {"type": "integer", "minimum": 0},
          "reason": {"type": ["string", "null"]},
          "evidence_error": {"type": ["string", "null"]}
        }
      }
    }
  }
}
