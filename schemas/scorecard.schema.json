{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience-gate.example.invalid/schemas/scorecard/v1",
  "title": "Resilience Gate chaos scorecard",
  "description": "A fail-closed metric-verdict contract; release linkage is added in C084.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment", "verdict", "checks"],
  "properties": {
    "schema_version": {"const": "resilience-gate.scorecard/v1"},
    "experiment": {"type": "string", "minLength": 1},
    "verdict": {"type": "string", "enum": ["pass", "fail"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "verdict",
          "observed",
          "operator",
          "threshold",
          "unit",
          "expression",
          "query_kind",
          "sample_count",
          "reason",
          "evidence_error"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "verdict": {"type": "string", "enum": ["pass", "fail"]},
          "observed": {"type": ["number", "null"]},
          "operator": {"type": "string", "enum": ["<", "<=", ">", ">=", "=="]},
          "threshold": {"type": "number"},
          "unit": {"type": "string"},
          "expression": {"type": "string", "minLength": 1},
          "query_kind": {"type": "string", "enum": ["instant", "range"]},
          "sample_count": {"type": "integer", "minimum": 0},
          "reason": {"type": ["string", "null"]},
          "evidence_error": {"type": ["string", "null"]}
        }
      }
    }
  }
}
